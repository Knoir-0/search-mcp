# ==============================================================================
# Search MCP Server Environment Configuration
# Copy this file to `.env` and fill in the required keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Custom Search JSON API (REQUIRED for `search_google`)
# Free tier: 100 search queries per day.
# Get API Key: https://developers.google.com/custom-search/v1/overview
# Get CSE ID (Programmable Search Engine): https://programmablesearchengine.google.com/
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ------------------------------------------------------------------------------
# 2. GitHub REST API (OPTIONAL for `search_github` & `get_github_file`)
# Unauthenticated (no key): 10 search requests/min (repositories, issues/PRs).
# With Personal Access Token: 30 search requests/min + unlocks `code` search type.
# Create a token (no special scopes needed for public repos): https://github.com/settings/tokens
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 3. Stack Exchange API v2.3 (OPTIONAL for `search_stackoverflow` & `get_stackoverflow_question`)
# Unauthenticated (no key): 300 requests/day.
# With Stack Apps Request Key: 10,000 requests/day.
# Register for a free key: https://stackapps.com/apps/oauth/register
# ------------------------------------------------------------------------------
STACKEXCHANGE_KEY=

# ------------------------------------------------------------------------------
# 4. Reddit API (OPTIONAL for `search_reddit` & `get_reddit_post`)
# Unauthenticated (no key): Uses Reddit's public `.json` endpoints (~10 requests/min).
# With OAuth2 Client Credentials: 100 requests/min via `oauth.reddit.com`.
# Create a "script" or "web app" at: https://www.reddit.com/prefs/apps
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:search-mcp:0.1.0 (by /u/your_reddit_username)
